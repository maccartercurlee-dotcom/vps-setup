#!/bin/bash
set -eo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo -e "${RED}Запустите скрипт от имени root (sudo bash $0)${NC}"
    exit 1
fi

clear
echo -e "${GREEN}=== УСТАНОВКА VPN (3x-ui + XHTTP/Reality + Hysteria2 + Nginx) ===${NC}"

if [ -d "/etc/x-ui" ] || [ -d "/etc/nginx" ]; then
    echo -e "${RED}ВНИМАНИЕ: скрипт полностью удалит текущие установки 3x-ui и Nginx!${NC}"
    read -rp "Продолжить чистую установку? [y/N]: " CONFIRM
    [[ "$CONFIRM" =~ ^[Yy]$ ]] || { echo "Отменено."; exit 0; }
fi

read -rp "Домен (например, example.com): " RAW_DOMAIN
DOMAIN=$(echo "$RAW_DOMAIN" | tr -cd 'a-zA-Z0-9.-' | sed 's/^\.*//;s/\.*$//')
[ -z "$DOMAIN" ] && { echo -e "${RED}Домен пуст${NC}"; exit 1; }

echo -e "${YELLOW}Протоколы (1=VLESS, 2=Hysteria2, '1 2'=оба) [1 2]:${NC}"
read -rp "Выбор: " RAW_PROTOCOLS
[ -z "$RAW_PROTOCOLS" ] && RAW_PROTOCOLS="1 2"

USE_VLESS=0
USE_HY=0
for p in $RAW_PROTOCOLS; do
    case "$p" in
        1) USE_VLESS=1 ;;
        2) USE_HY=1 ;;
    esac
done

if [ "$USE_VLESS" -eq 0 ] && [ "$USE_HY" -eq 0 ]; then
    echo -e "${RED}Нужно выбрать хотя бы один протокол: 1, 2 или '1 2'${NC}"
    exit 1
fi

PROTOCOLS=""
[ "$USE_VLESS" -eq 1 ] && PROTOCOLS="1"
[ "$USE_HY" -eq 1 ] && PROTOCOLS="${PROTOCOLS:+$PROTOCOLS }2"

PANEL_PORT=2053
SUB_PORT=2096
NGINX_PORT=40000

systemctl stop x-ui nginx >/dev/null 2>&1 || true
export DEBIAN_FRONTEND=noninteractive
apt-get purge -y nginx nginx-common nginx-core nginx-full >/dev/null 2>&1 || true
rm -rf /etc/x-ui /usr/local/x-ui /usr/bin/x-ui /etc/systemd/system/x-ui.service /etc/nginx /var/www/decoy /var/www/certbot

apt-get update
apt-get install -y nginx certbot curl wget sqlite3 openssl python3
timedatectl set-ntp true >/dev/null 2>&1 || true

PANEL_USER="admin"
PANEL_PASS=$(openssl rand -hex 8)
WEB_PATH="/$(openssl rand -hex 16)/"
SUB_PATH="/$(openssl rand -hex 16)/"

if command -v ufw >/dev/null 2>&1 && ufw status | grep -q "Status: active"; then
    ufw allow 80/tcp >/dev/null 2>&1 || true
    ufw allow 443/tcp >/dev/null 2>&1 || true
    ufw allow 443/udp >/dev/null 2>&1 || true
fi

echo -e "${YELLOW}Установка 3x-ui...${NC}"
wget -qO /tmp/xui-install.sh https://raw.githubusercontent.com/mhsanaei/3x-ui/master/install.sh
printf "1\nn\n4\ny\n" | bash /tmp/xui-install.sh
rm -f /tmp/xui-install.sh

systemctl start x-ui
for _ in $(seq 1 15); do
    [ -s /etc/x-ui/x-ui.db ] && break
    sleep 1
done
sleep 2
systemctl stop x-ui

if [ ! -s /etc/x-ui/x-ui.db ]; then
    echo -e "${RED}ОШИБКА: база /etc/x-ui/x-ui.db не создана.${NC}"
    exit 1
fi

# --- Заглушка (Веб-интерфейс ИИ) ---
mkdir -p /var/www/decoy /var/www/certbot
cat > /var/www/decoy/index.html <<'EOF'
