            "trustedXForwardedFor": [], "addressPortStrategy": "none", "customSockopt": []
        }
    }
    c.execute(
        "INSERT INTO inbounds (user_id,up,down,total,expiry_time,remark,port,protocol,settings,stream_settings,tag,sniffing,enable) "
        "VALUES (1,0,0,0,0,'VLESS-REALITY',443,'vless',?,?,'in-443-tcp',?,1)",
        (json.dumps(vless_settings), json.dumps(vless_stream), '{"enabled":true,"destOverride":["http","tls","quic","fakedns"]}')
    )
    vless_id = c.lastrowid

# --- Hysteria2 ---
if "2" in PROTOCOLS:
    hc = [{
        "id": x["uuid"], "email": x["name"], "subId": x["sub"], "auth": x["uuid"], "password": x["uuid"],
        "flow": "", "security": "auto", "limitIp": 0, "totalGB": 0, "expiryTime": 0,
        "enable": True, "tgId": 0, "reset": 0, "resetDay": 0, "resetWeekday": 0, "resetMax": 0,
        "comment": "", "created_at": now, "updated_at": now
    } for x in cd]
    hy_settings = {"clients": hc, "version": 2}
    hy_stream = {
        "network": "hysteria",
        "hysteriaSettings": {
            "version": 2, "udpIdleTimeout": 60,
            "masquerade": {"type": "proxy", "url": f"https://{DOMAIN}/", "rewriteHost": True}
        },
        "security": "tls",
        "tlsSettings": {
            "serverName": DOMAIN, "minVersion": "1.3", "maxVersion": "1.3",
            "certificates": [{"certificateFile": CERT_PATH, "keyFile": KEY_PATH, "useFile": True}],
            "alpn": ["h3"],
            "settings": {"fingerprint": "firefox", "echConfigList": "", "echServerKeys": ""}
        },
        "finalmask": {
            "quicParams": {
                "congestion": "bbr", "debug": False, "maxIdleTimeout": 30, "keepAlivePeriod": 10,
                "disablePathMTUDiscovery": False, "maxIncomingStreams": 2048,
                "initStreamReceiveWindow": 16777216, "maxStreamReceiveWindow": 16777216,
                "initConnectionReceiveWindow": 33554432, "maxConnectionReceiveWindow": 33554432,
