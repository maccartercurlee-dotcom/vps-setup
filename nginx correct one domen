# --- Хук автообновления сертификатов для Nginx и 3x-ui ---
mkdir -p /etc/letsencrypt/renewal-hooks/deploy
cat > /etc/letsencrypt/renewal-hooks/deploy/reload-xui-nginx.sh <<'HOOK'
#!/bin/bash
systemctl reload nginx || true
systemctl restart x-ui || true
HOOK
chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-xui-nginx.sh

LISTEN_80_V6=""
if [ -s /proc/net/if_inet6 ]; then
    LISTEN_80_V6="    listen [::]:80;"
fi

CERT_PATH="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
KEY_PATH="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
SELF_SIGNED=0

echo -e "${YELLOW}Получаем SSL-сертификат Let's Encrypt...${NC}"
rm -f /etc/nginx/sites-enabled/default
cat > /etc/nginx/sites-available/decoy <<EOF
server {
    listen 80;
${LISTEN_80_V6}
    server_name $DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { root /var/www/decoy; index index.html; }
}
EOF
ln -sf /etc/nginx/sites-available/decoy /etc/nginx/sites-enabled/decoy
systemctl restart nginx

certbot certonly --webroot -w /var/www/certbot \
    --cert-name "$DOMAIN" -d "$DOMAIN" \
    --non-interactive --agree-tos -m "admin@$DOMAIN" || true

if [ ! -f "$CERT_PATH" ]; then
    SELF_SIGNED=1
    echo -e "${RED}Не удалось получить сертификат Let's Encrypt. Создаётся временный самоподписанный сертификат.${NC}"
    mkdir -p /etc/ssl/self-signed
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout /etc/ssl/self-signed/privkey.pem \
        -out /etc/ssl/self-signed/fullchain.pem \
        -subj "/CN=$DOMAIN" >/dev/null 2>&1
    CERT_PATH="/etc/ssl/self-signed/fullchain.pem"
    KEY_PATH="/etc/ssl/self-signed/privkey.pem"
fi

export DB_DOMAIN="$DOMAIN" DB_PANEL_PORT="$PANEL_PORT" DB_WEB_PATH="$WEB_PATH"
export DB_SUB_PORT="$SUB_PORT" DB_SUB_PATH="$SUB_PATH" DB_CERT_PATH="$CERT_PATH"
export DB_KEY_PATH="$KEY_PATH" DB_PROTOCOLS="$PROTOCOLS" DB_NGINX_PORT="$NGINX_PORT"

echo -e "${YELLOW}Заполнение базы 3x-ui...${NC}"
python3 <<'PYEOF'
import glob, json, os, secrets, sqlite3, subprocess, sys, time, uuid

DOMAIN = os.environ['DB_DOMAIN']
PANEL_PORT = os.environ['DB_PANEL_PORT']
WEB_PATH = os.environ['DB_WEB_PATH']
SUB_PORT = os.environ['DB_SUB_PORT']
SUB_PATH = os.environ['DB_SUB_PATH']
CERT_PATH = os.environ['DB_CERT_PATH']
KEY_PATH = os.environ['DB_KEY_PATH']
NGINX_PORT = os.environ['DB_NGINX_PORT']
PROTOCOLS = os.environ['DB_PROTOCOLS'].split()

conn = sqlite3.connect('/etc/x-ui/x-ui.db')
c = conn.cursor()
now = int(time.time() * 1000)

for tbl in ("client_inbounds", "client_traffics", "clients", "inbounds", "settings"):
    c.execute(f"DELETE FROM {tbl}")

settings = [
    ('webPort', str(PANEL_PORT)),
    ('webBasePath', WEB_PATH),
    ('webListen', '127.0.0.1'),
    ('subPort', str(SUB_PORT)),
    ('subPath', SUB_PATH),
    ('subListen', '127.0.0.1'),
    ('subEnable', 'true'),
    ('subDomain', DOMAIN),
    ('subURI', f"https://{DOMAIN}{SUB_PATH}"),
]
for k, v in settings:
    c.execute("INSERT INTO settings (key, value) VALUES (?, ?)", (k, v))

names = ["user1", "user2"]
cd = [{"name": n, "uuid": str(uuid.uuid4()), "sub": secrets.token_hex(8)} for n in names]

vless_id = None
hy_id = None

# --- VLESS REALITY (XHTTP) ---
if "1" in PROTOCOLS:
    bins = sorted(p for p in glob.glob('/usr/local/x-ui/bin/xray*') if os.path.isfile(p) and os.access(p, os.X_OK))
    if not bins:
        print("Ошибка: бинарник xray не найден в /usr/local/x-ui/bin/", file=sys.stderr)
        sys.exit(1)
    k = subprocess.check_output([bins[0], "x25519"]).decode()
    pk_list = [l.split()[-1] for l in k.splitlines() if 'Private' in l]
    pub_list = [l.split()[-1] for l in k.splitlines() if 'Password' in l or 'Public' in l]
    if not pk_list or not pub_list:
        print(f"Ошибка разбора ключей x25519:\n{k}", file=sys.stderr)
        sys.exit(1)
    pk, pub = pk_list[0], pub_list[0]

    shorts = [secrets.token_hex(n)[:n] for n in [8, 2, 10, 6, 14, 4, 12, 16]]
    spider = "/" + secrets.token_urlsafe(10)[:15]
    vc = [{
        "id": x["uuid"], "email": x["name"], "subId": x["sub"], "flow": "", "security": "auto",
        "limitIp": 0, "totalGB": 0, "expiryTime": 0, "enable": True, "tgId": 0,
        "reset": 0, "resetDay": 0, "resetWeekday": 0, "resetMax": 0,
        "comment": "", "created_at": now, "updated_at": now
    } for x in cd]

    vless_settings = {"clients": vc, "decryption": "none", "encryption": "none"}
    vless_stream = {
        "network": "xhttp",
        "xhttpSettings": {
            "path": "/api/v1/ws", "host": "", "mode": "stream-one",
            "xPaddingBytes": "10-100", "xPaddingObfsMode": True, "xPaddingKey": "",
            "xPaddingHeader": "", "xPaddingPlacement": "cookie", "xPaddingMethod": "repeat-x",
            "sessionIDPlacement": "", "sessionIDKey": "", "sessionIDTable": "Base62",
            "sessionIDLength": "8-16", "seqPlacement": "", "seqKey": "",
            "uplinkDataPlacement": "", "uplinkDataKey": "", "scMaxEachPostBytes": "",
            "noSSEHeader": False, "scMaxBufferedPosts": 30, "scStreamUpServerSecs": "20-80",
            "serverMaxHeaderBytes": 0, "uplinkHTTPMethod": "POST",
            "headers": {
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:128.0) Gecko/20100101 Firefox/128.0",
                "Accept-Language": "en-US,en;q=0.5",
                "Accept": "text/event-stream"
            },
            "scMinPostsIntervalMs": "", "uplinkChunkSize": 0, "noGRPCHeader": False,
            "xmux": {
                "maxConcurrency": "16-32", "maxConnections": 0, "cMaxReuseTimes": 0,
                "hMaxRequestTimes": "600-900", "hMaxReusableSecs": "1800-3000", "hKeepAlivePeriod": 0
            },
            "enableXmux": True
        },
        "security": "reality",
        "realitySettings": {
            "show": False, "xver": 0, "target": f"127.0.0.1:{NGINX_PORT}",
            "serverNames": [DOMAIN], "privateKey": pk,
            "minClientVer": "", "maxClientVer": "", "maxTimediff": 0,
            "shortIds": shorts, "mldsa65Seed": "",
            "settings": {
                "publicKey": pub, "fingerprint": "firefox",
                "serverName": DOMAIN, "spiderX": spider, "mldsa65Verify": ""
            }
        },
        "sockopt": {
            "tcpFastOpen": True, "tcpcongestion": "bbr", "acceptProxyProtocol": False,
            "mark": 0, "tproxy": "off", "tcpMptcp": False, "penetrate": False,
