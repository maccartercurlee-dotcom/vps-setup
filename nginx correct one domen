            }
        }
    }
    c.execute(
        "INSERT INTO inbounds (user_id,up,down,total,expiry_time,remark,port,protocol,settings,stream_settings,tag,sniffing,enable) "
        "VALUES (1,0,0,0,0,'Hysteria2',443,'hysteria',?,?,'in-443-udp',?,1)",
        (json.dumps(hy_settings), json.dumps(hy_stream), '{"enabled":true,"destOverride":["http","tls"]}')
    )
    hy_id = c.lastrowid

first_inb = vless_id if vless_id else hy_id
for x in cd:
    c.execute(
        "INSERT INTO clients (email,sub_id,uuid,password,auth,flow,security,limit_ip,total_gb,expiry_time,enable,tg_id,comment,reset,group_name,created_at,updated_at) "
        "VALUES (?,?,?,?,?,'','auto',0,0,0,1,0,'',0,'',?,?)",
        (x["name"], x["sub"], x["uuid"], x["uuid"], x["uuid"], now, now)
    )
    cid = c.lastrowid
    for iid in (vless_id, hy_id):
        if iid is None:
            continue
        c.execute(
            "INSERT INTO client_inbounds (client_id,inbound_id,flow_override,created_at) VALUES (?,?,'',?)",
            (cid, iid, now)
        )
    c.execute(
        "INSERT INTO client_traffics (inbound_id,enable,email,up,down,expiry_time,total,reset,last_online) "
        "VALUES (?,1,?,0,0,0,0,0,0)",
        (first_inb, x["name"])
    )

tmpl = {
    "log": {"loglevel": "warning"},
    "api": {"services": ["HandlerService", "LoggerService", "StatsService", "RoutingService"], "tag": "api"},
    "stats": {},
    "policy": {
        "levels": {"0": {"statsUserUplink": True, "statsUserDownlink": True, "statsUserOnline": True}},
        "system": {"statsInboundUplink": True, "statsInboundDownlink": True, "statsOutboundUplink": True, "statsOutboundDownlink": True}
    },
    "inbounds": [{
        "listen": "127.0.0.1", "port": 62789, "protocol": "dokodemo-door",
        "settings": {"address": "127.0.0.1"}, "tag": "api", "sniffing": {"enabled": False}
    }],
    "outbounds": [
        {"protocol": "freedom", "tag": "direct"},
        {"protocol": "blackhole", "tag": "blocked"}
    ],
    "routing": {
        "domainStrategy": "AsIs",
        "rules": [
            {"type": "field", "inboundTag": ["api"], "outboundTag": "api"},
            {"type": "field", "ip": ["geoip:private"], "outboundTag": "blocked"}
        ]
    }
}
c.execute("INSERT INTO settings (key, value) VALUES ('xrayTemplateConfig', ?)", (json.dumps(tmpl),))

conn.commit()
conn.close()
print("DB OK")
PYEOF

NGINX_VER=$(nginx -v 2>&1 | sed -nE 's/.*nginx\/([0-9]+\.[0-9]+\.[0-9]+).*/\1/p')
NGINX_VER=${NGINX_VER:-0.0.0}
if dpkg --compare-versions "$NGINX_VER" ge "1.25.1"; then
    SSL_OPTS="ssl"
    HTTP2_LINE="    http2 on;"
else
    SSL_OPTS="ssl http2"
    HTTP2_LINE=""
fi

if [ "$USE_VLESS" -eq 1 ]; then
    LISTEN_NGINX="    listen 127.0.0.1:${NGINX_PORT} ${SSL_OPTS} default_server;"
else
    LISTEN_NGINX="    listen 443 ${SSL_OPTS} default_server;"
    if [ -s /proc/net/if_inet6 ]; then
        LISTEN_NGINX="${LISTEN_NGINX}"$'\n'"    listen [::]:443 ${SSL_OPTS} default_server;"
    fi
fi

cat > /etc/nginx/sites-available/decoy <<NGINXEOF
server {
    listen 80;
${LISTEN_80_V6}
    server_name $DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://\$host\$request_uri; }
}

server {
${LISTEN_NGINX}
${HTTP2_LINE}
    server_name $DOMAIN;
    server_tokens off;

    ssl_certificate $CERT_PATH;
    ssl_certificate_key $KEY_PATH;

    # TLS 1.2 + 1.3 (совместимость подписок на Windows/Schannel + Reality TLS 1.3/X25519)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_conf_command Ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256;

    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;

    location / {
        root /var/www/decoy;
        index index.html;
    }

    location $WEB_PATH {
        proxy_pass http://127.0.0.1:$PANEL_PORT;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location $SUB_PATH {
        proxy_pass http://127.0.0.1:$SUB_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
NGINXEOF

rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/decoy /etc/nginx/sites-enabled/decoy
nginx -t && systemctl restart nginx

x-ui setting -username "$PANEL_USER" -password "$PANEL_PASS" >/dev/null 2>&1 || true
systemctl start x-ui
sleep 3

echo ""
echo -e "${GREEN}=== ГОТОВО ===${NC}"
echo "Логин:    $PANEL_USER"
echo "Пароль:   $PANEL_PASS"
echo "Панель:   https://$DOMAIN$WEB_PATH"
echo "Подписки: https://$DOMAIN$SUB_PATH"
if [ "$SELF_SIGNED" -eq 1 ]; then
    echo -e "${YELLOW}ВНИМАНИЕ: используется самоподписанный сертификат. Проверьте DNS и перевыпустите сертификат через certbot.${NC}"
fi
